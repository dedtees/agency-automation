# --- Core ---
# Supabase: Project > Connect > ORMs > Prisma gives both strings.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agency_dev"   # pooled (6543, ?pgbouncer=true) on Supabase
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/agency_dev"     # direct (5432), used for migrations
APP_URL=""                             # optional on Vercel (defaults to the production URL)
CRON_SECRET=""                         # any long random string; lets Vercel Cron run queued jobs
AGENCY_NAME="Your Agency"
AGENCY_FROM_EMAIL="hello@example.com"
ADMIN_PASSWORD=""                      # required in production (Basic auth, user "admin")

# --- Approval gates (default: on) ---
OUTREACH_REQUIRES_APPROVAL=true        # every client email waits in the Outbox for you
CONCEPTS_REQUIRE_APPROVAL=true         # concepts hidden from client until you approve
CONCEPTS_PER_CLIENT=3
PORTAL_LINK_DAYS=30

# --- Providers (swap without code changes) ---
CONCEPT_PROVIDER=library               # library | researched (uses the client's researched profile)
TEMPLATE_PROVIDER=fake                 # fake | wp-block-theme (real installable WordPress block theme + zip)
STORAGE_DIR=./storage                  # generated themes, zips and preview screenshots
DOWNLOAD_SIGNING_SECRET=               # required in production: signs template download links
EMAIL_PROVIDER=console                 # console | outlook | resend
PAYMENT_PROVIDER=fake                  # fake | stripe
HOSTING_PROVIDER=fake                  # fake | (later) managed WP host or VPS + WP-CLI

# --- Pricing (cents) ---
PRICE_TEMPLATE_CENTS=49900
PRICE_SETUP_CENTS=99900
PRICE_MONTHLY_CENTS=4900

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email: Outlook / Microsoft 365 (EMAIL_PROVIDER=outlook) ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
OUTLOOK_SENDER=                        # mailbox to send from, e.g. hello@youragency.com

# --- Email: Resend (EMAIL_PROVIDER=resend) ---
RESEND_API_KEY=

# --- QuickBooks Online API (optional; the CSV export import works without it) ---
QUICKBOOKS_ENV=sandbox
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REALM_ID=
QUICKBOOKS_REFRESH_TOKEN=
